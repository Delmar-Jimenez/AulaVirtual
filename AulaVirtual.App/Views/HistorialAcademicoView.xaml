<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.HistorialAcademicoView"
             Title="Historial Académico">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Historial de la Carrera" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Label Text="Aún no tienes cursos en tu historial académico." 
               IsVisible="{Binding EstaVacio}" 
               FontSize="16" 
               TextColor="Gray" 
               HorizontalOptions="Center" 
               VerticalOptions="CenterAndExpand" 
               Margin="0,50,0,0" />

        <CollectionView ItemsSource="{Binding HistorialAgrupado}" IsGrouped="True" Margin="0,10,0,0">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding NombreGrupo}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           Padding="0,10,0,5" 
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" CornerRadius="8" BorderColor="LightGray">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="{Binding NombreCurso}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                <Label Text="{Binding Estado}" FontSize="14" FontAttributes="Italic" TextColor="Gray" VerticalOptions="Center" />
                                <Label Text="{Binding NotaFinal, StringFormat='Nota: {0}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Aprobado">
                                            <Setter Property="TextColor" Value="Green" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Reprobado">
                                            <Setter Property="TextColor" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pendiente">
                                            <Setter Property="TextColor" Value="Orange" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
