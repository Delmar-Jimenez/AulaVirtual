<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.CursosDocenteView"
             Title="Mis Cursos (Docente)">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Cursos Activos" FontSize="20" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding ActiveCourses}" SelectionMode="Single" SelectionChangedCommand="{Binding CursoSeleccionadoCommand}" SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Nombre}" FontSize="16" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <Label Text="Cursos Inactivos" FontSize="20" FontAttributes="Bold" Margin="0,20,0,0" />
        <CollectionView ItemsSource="{Binding InactiveCourses}" SelectionMode="Single" SelectionChangedCommand="{Binding CursoSeleccionadoCommand}" SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Nombre}" FontSize="16" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>



