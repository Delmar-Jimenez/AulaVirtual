<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.CursosView"
             Title="Gestión de Cursos">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Administración de Cursos" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Crear Nuevo Curso" FontSize="18" FontAttributes="Bold" />
                <Entry Placeholder="Nombre del curso" Text="{Binding NuevoCursoNombre}" />
                <Entry Placeholder="Créditos" Keyboard="Numeric" Text="{Binding NuevoCursoCreditos}" />
                <Button Text="Guardar" Command="{Binding GuardarCursoCommand}" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Cargar Cursos" Command="{Binding CargarCursosCommand}" />
        <CollectionView ItemsSource="{Binding Cursos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Nombre}" FontSize="18" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>



