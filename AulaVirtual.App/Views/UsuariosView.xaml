<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.UsuariosView"
             Title="Gestión de Usuarios">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Administración de Usuarios" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Crear Nuevo Usuario" FontSize="18" FontAttributes="Bold" />
                <Entry Placeholder="Nombre completo" Text="{Binding NuevoUsuarioNombreCompleto}" />
                <Entry Placeholder="Correo electrónico" Keyboard="Email" Text="{Binding NuevoUsuarioCorreo}" />
                <Entry Placeholder="Contraseña" IsPassword="True" Text="{Binding NuevoUsuarioContrasena}" />
                <Picker Title="Seleccionar Rol" ItemsSource="{Binding RolesDisponibles}" SelectedItem="{Binding RolSeleccionado}" />
                <Button Text="Guardar" Command="{Binding GuardarUsuarioCommand}" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Cargar Usuarios" Command="{Binding CargarUsuariosCommand}" />
        <CollectionView ItemsSource="{Binding Usuarios}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding NombreCompleto}" FontSize="18" />
                        <Label Text="{Binding Correo}" FontSize="14" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>



