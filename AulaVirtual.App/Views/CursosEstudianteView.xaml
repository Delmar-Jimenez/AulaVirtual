<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.CursosEstudianteView"
             Title="Mis Cursos (Estudiante)">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Cursos Asignados" FontSize="20" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding AssignedCourses}" SelectionMode="Single" SelectionChangedCommand="{Binding CursoSeleccionadoCommand}" SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Nombre}" FontSize="16" />
                        <Label Text="{Binding Creditos, StringFormat='Créditos: {0}'}" FontSize="14" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="Notas del Semestre" Command="{Binding IrANotasCommand}" BackgroundColor="#1976D2" TextColor="White" />
            <Button Text="Historial Académico" Command="{Binding IrAHistorialCommand}" BackgroundColor="#388E3C" TextColor="White" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>



