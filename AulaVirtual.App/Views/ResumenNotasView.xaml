<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.ResumenNotasView"
             Title="Resumen de Notas">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="{Binding CursoActual.Nombre, StringFormat='Resumen: {0}'}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Button Text="Cargar Resumen" Command="{Binding LoadGradeSummaryCommand}" />
        <CollectionView ItemsSource="{Binding StudentGrades}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Padding="10" Spacing="20">
                        <Label Text="{Binding Student.NombreCompleto}" FontSize="16" WidthRequest="200" />
                        <Label Text="{Binding NotaFinal, StringFormat='Nota Final: {0}'}" FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding Estado}" FontSize="16" TextColor="Blue" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>



