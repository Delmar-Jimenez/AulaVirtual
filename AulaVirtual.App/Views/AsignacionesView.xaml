<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.AsignacionesView"
             Title="Gestión de Asignaciones">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Administración de Asignaciones" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Frame BorderColor="LightGray" CornerRadius="8" Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Nueva Asignación" FontSize="18" FontAttributes="Bold" />
                
                <Picker Title="Seleccionar Estudiante" 
                        ItemsSource="{Binding EstudiantesDisponibles}" 
                        ItemDisplayBinding="{Binding NombreCompleto}"
                        SelectedItem="{Binding EstudianteSeleccionado}" />
                        
                <Picker Title="Seleccionar Curso" 
                        ItemsSource="{Binding CursosDisponibles}" 
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding CursoSeleccionado}" />
                        
                <Button Text="Guardar Asignación" Command="{Binding GuardarAsignacionCommand}" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Cargar Asignaciones" Command="{Binding CargarAsignacionesCommand}" />
        <Label Text="Estudiantes Asignados" FontSize="18" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding AsignacionesEstudiante}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Student.NombreCompleto}" FontSize="16" />
                        <Label Text="{Binding Curso.Nombre}" FontSize="14" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>



