<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.InicioSesionView"
             Title="Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0f172a">

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e1b4b" Offset="0.0" />
                    <GradientStop Color="#312e81" Offset="0.5" />
                    <GradientStop Color="#0f172a" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Glassmorphism Container -->
        <Frame BackgroundColor="#20ffffff" 
               BorderColor="#40ffffff"
               CornerRadius="20"
               Padding="30"
               Margin="20"
               HorizontalOptions="Center" 
               VerticalOptions="Center"
               MaximumWidthRequest="400"
               HasShadow="True">
            
            <VerticalStackLayout Spacing="25">
                
                <Label Text="Aula Virtual"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                
                <Label Text="Inicia sesión para continuar"
                       FontSize="16"
                       TextColor="#cbd5e1"
                       HorizontalOptions="Center"
                       Margin="0,-15,0,10" />

                <Entry Placeholder="Correo Electrónico"
                       Text="{Binding Correo}"
                       Keyboard="Email"
                       TextColor="White"
                       PlaceholderColor="#94a3b8"
                       BackgroundColor="#33000000"
                       HeightRequest="50" />
                
                <Entry Placeholder="Contraseña"
                       Text="{Binding Password}"
                       IsPassword="True"
                       TextColor="White"
                       PlaceholderColor="#94a3b8"
                       BackgroundColor="#33000000"
                       HeightRequest="50" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#ef4444"
                       FontSize="14"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasError}"/>

                <Button Text="Ingresar"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#6366f1"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="55"
                        FontAttributes="Bold"
                        FontSize="18" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                   IsVisible="{Binding IsBusy}" 
                                   Color="White" 
                                   HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>




