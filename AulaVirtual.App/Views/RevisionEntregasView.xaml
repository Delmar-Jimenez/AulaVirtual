<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AulaVirtual.App.ViewModels"
             x:Class="AulaVirtual.App.Views.RevisionEntregasView"
             Title="Revisión de Entregas">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="{Binding CurrentAssignment.Titulo, StringFormat='Entregas para: {0}'}" FontSize="20" FontAttributes="Bold" />
        <Button Text="Cargar Entregas" Command="{Binding CargarEntregasCommand}" />
        <CollectionView ItemsSource="{Binding Entregas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Student.NombreCompleto}" FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding FechaEntrega, StringFormat='Fecha de entrega: {0:g}'}" FontSize="14" TextColor="Gray" />
                        <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                            <Label Text="Nota:" VerticalOptions="Center" />
                            <Entry Text="{Binding Nota}" Keyboard="Numeric" WidthRequest="60" />
                            <Button Text="Guardar" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RevisionEntregasViewModel}}, Path=SaveGradeCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>




